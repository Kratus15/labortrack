# Production environment template only. Do not put real passwords, JWT secrets,
# or other sensitive values in this file. Copy this template to .env.production
# on the EC2 server and replace the placeholder values there.

# PostgreSQL
POSTGRES_DB=labortrack
POSTGRES_USER=labortrack
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# JWT
JWT_SECRET=CHANGE_ME_STRONG_JWT_SECRET
JWT_EXPIRATION=1h

# Production frontend origin
# Replace with the EC2 public URL after the instance is launched
CORS_ALLOWED_ORIGINS=http://EC2_PUBLIC_IP

# Rate limiting
RATE_LIMIT_ENABLED=true